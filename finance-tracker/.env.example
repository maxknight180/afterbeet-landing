# Copy this file to .env and fill it in. Never commit .env.

# --- Plaid (bank linking). Leave blank to run in demo mode. ---
# Get keys at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (fake test banks) or "production" (your real bank)
PLAID_ENV=sandbox
# Countries of the banks you'll link, comma-separated (US, CA, GB, ...)
PLAID_COUNTRY_CODES=US
# How much history to import when you link a bank (max 730)
PLAID_DAYS_REQUESTED=180

# Optional: public URL of /api/webhook so Plaid can ping you the moment new
# transactions land, e.g. https://your-app.example.com/api/webhook
PLAID_WEBHOOK_URL=
# Only needed for banks that use OAuth (most big US banks in production).
# Must also be added under "Allowed redirect URIs" in the Plaid dashboard.
PLAID_REDIRECT_URI=

# --- App ---
PORT=3000
# 127.0.0.1 = only this computer can open the app. Use 0.0.0.0 when hosting.
HOST=127.0.0.1
# Set this if the app is reachable by anyone but you (any username works).
APP_PASSWORD=
CURRENCY=USD
# How often to check your banks for new transactions (minutes)
SYNC_INTERVAL_MINUTES=15
# Demo mode only: seconds between fake purchases (0 = off)
DEMO_PURCHASE_SECONDS=90
